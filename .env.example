# ============================================================
# Olla Nest — Environment Configuration
# Copy this file to .env and set real values before running.
# ============================================================

# ── Required ─────────────────────────────────────────────────
# API key encryption secret — generate with: openssl rand -hex 32
# Encrypts all stored provider API keys at rest.
# CHANGING THIS AFTER FIRST BOOT WILL INVALIDATE ALL STORED KEYS.
ENCRYPTION_KEY=replace-with-64-char-hex-string

# ── Ollama ───────────────────────────────────────────────────
# URL of your Ollama instance.
# Same machine:    http://localhost:11434
# Remote machine:  http://192.168.x.x:11434
OLLAMA_URL=http://localhost:11434

# ── First-boot admin credentials ─────────────────────────────
# Seeded on first startup only (when no users exist in the DB).
# Leave DEFAULT_ADMIN_PASSWORD blank — a secure random password
# will be auto-generated and printed once to the server log.
DEFAULT_ADMIN_EMAIL=admin@ollanest.local
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_ON_FIRST_BOOT

# ── Default user password ─────────────────────────────────────
# Assigned to new user accounts created by an admin.
DEFAULT_USER_PASSWORD=SET_A_SECURE_USER_PASSWORD_HERE

# ── Server ports ──────────────────────────────────────────────
# Each service binds its own HTTP port and can run on ANY port.
# Read as ADMIN_PORT / USER_PORT by the respective service.
# Admin control panel  (default: 8080)
# ADMIN_PORT=8080
# Employee workspace   (default: 8081)
# USER_PORT=8081

# ── Public base URLs ──────────────────────────────────────────
# Absolute base URL each service advertises — used as the allowed WebSocket
# origin and for SSO callbacks / absolute links. Set these to match your real
# host and port when running behind a proxy or on non-default ports.
# Admin: ADMIN_BASE_URL (default: http://localhost:8080)
# User:  BASE_URL       (default: http://localhost:8081)
# ADMIN_BASE_URL=http://localhost:8080
# BASE_URL=http://localhost:8081

# ── Session cookies ───────────────────────────────────────────
# Cookies are scoped by HOST, not port. When admin and user run on the same
# host (e.g. both on localhost) they MUST use different cookie names, or logging
# in/out of one clobbers the other's session. Defaults already differ:
#   admin → olla_nest_session   user → olla_nest_user_session
# Each service reads SESSION_COOKIE_NAME independently; override only if you run
# multiple deployments on one host and need custom names.
# (admin)  SESSION_COOKIE_NAME=olla_nest_session
# (user)   SESSION_COOKIE_NAME=olla_nest_user_session

# ── Data directory ────────────────────────────────────────────
# SQLite database and backups location (default: ./data)
# DATA_DIR=./data

# Static frontend assets directory (default: ./public)
# STATIC_DIR=./public

# ── Security ──────────────────────────────────────────────────
# Set true when running behind HTTPS — adds Secure flag to cookies
# COOKIE_SECURE=false

# Trusted reverse-proxy IP for X-Forwarded-For (rate limiting)
# TRUSTED_PROXY=127.0.0.1

# ── Logs: standalone Grafana + Loki ───────────────────────────
# Logs are viewed in a standalone Grafana UI (not in the admin panel),
# backed by Loki. Start it with:  bash scripts/start_monitoring.sh
# Grafana UI port — the standalone log UI (default: 8082)
# GRAFANA_PORT=8082
# Loki ingest/query API port (default: 3100)
# LOKI_PORT=3100
# Where the apps push logs. Defaults to the local Loki above; change if Loki
# runs on a different host/port (keep the /loki/api/v1/push path).
# LOKI_URL=http://localhost:3100/loki/api/v1/push
# Toggle the Loki appender wiring (apps must also run with the "loki" profile).
# LOKI_ENABLED=true

# ── Optional: pre-configured API keys ─────────────────────────
# These can also be added via Admin → Providers in the UI.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
