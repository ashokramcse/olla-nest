PORT=3000
OLLAMA_URL=http://localhost:11434

# First boot admin
DEFAULT_ADMIN_EMAIL=admin@ollanest.local
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_ON_FIRST_BOOT

# local = SQLite + JSON document store + in-memory realtime fallback
# production = PostgreSQL + MongoDB + Redis target architecture
STORAGE_MODE=local

# Production storage targets
DATABASE_URL=postgresql://olla_nest:olla_nest@localhost:5432/olla_nest
MONGODB_URI=mongodb://localhost:27017/olla_nest
REDIS_URL=redis://localhost:6379

# Local fallback paths
SQLITE_PATH=./data/olla-nest.sqlite
DOCUMENT_DB_PATH=./data/documents.json
WORKSPACE_ROOT=./data/workspace
