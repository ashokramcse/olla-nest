# ============================================================
# Olla Nest — Docker Environment Configuration
# Copy this file to .env and set real values before running.
# ============================================================

# First-boot admin credentials
# The admin account is seeded on first startup using these values.
# Change the password immediately after first login.
DEFAULT_ADMIN_EMAIL=admin@ollanest.local
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_ON_FIRST_BOOT

# Default employee password (used when creating users without a specified password)
DEFAULT_USER_PASSWORD=CHANGE_ME_ON_FIRST_BOOT

# Ollama URL
# On macOS/Windows Docker Desktop: http://host.docker.internal:11434
# On Linux Docker with host networking: http://host.docker.internal:11434
#   (extra_hosts is pre-configured in docker-compose.yml for Linux)
# If Ollama runs on a different machine: http://<machine-ip>:11434
OLLAMA_URL=http://host.docker.internal:11434
