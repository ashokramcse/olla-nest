<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- ===================================================================
	     Olla Nest — Company AI Workspace
	     Runtime : Oracle Java 26 JVM  (bytecode: Java 21 LTS — Spring Boot ASM compat)
	     Framework: Spring Boot 3.5.14 (latest stable, May 2026)
	     Database : SQLite 3.49.x via JDBC  (BOM-managed)
	     Build    : Maven 3.9+
	     Features : 20+ connectors, SSO (Google/OIDC/SAML), web search,
	                voice/image generation, deep research
	     =================================================================== -->

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.14</version>  <!-- Latest stable Spring Boot patch -->
		<relativePath />
	</parent>

	<groupId>com.ollanest</groupId>
	<artifactId>olla-nest</artifactId>
	<version>2026.1.4</version>
	<name>olla-nest</name>
	<description>Olla Nest – Company AI Workspace (Java Spring Boot)</description>

	<!-- ===================================================================
	     Version Catalog — all explicit versions in one place
	     Spring Boot BOM manages: sqlite-jdbc, flyway, jackson, spring-security
	     We pin: spring-ai-bom, pdfbox
	     =================================================================== -->
	<properties>
		<!-- JVM target: Java 26 (Oracle).  Spring Boot 3.5.x ASM does not yet
		     support class-file version 70 (Java 26), so we compile to Java 21
		     LTS bytecode and run on the Java 26 JVM. -->
		<java.version>26</java.version>
		<maven.compiler.release>21</maven.compiler.release>

		<!-- Third-party BOMs / versions NOT managed by Spring Boot BOM -->
		<spring-ai.version>1.0.0</spring-ai.version>   <!-- Spring AI GA -->
		<pdfbox.version>3.0.7</pdfbox.version>          <!-- Apache PDFBox (latest stable) -->

		<!-- Managed automatically by Spring Boot 3.5.3 BOM (no override needed):
		     sqlite-jdbc    3.49.1.0
		     flyway-core    11.x
		     jackson        2.18.x
		     spring-security 6.4.x                      -->
	</properties>

	<!-- ===================================================================
	     BOM Imports
	     =================================================================== -->
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.ai</groupId>
				<artifactId>spring-ai-bom</artifactId>
				<version>${spring-ai.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<!-- ===================================================================
	     Dependencies
	     =================================================================== -->
	<dependencies>

		<!-- ── Web ─────────────────────────────────────────────────────── -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<!-- ── WebSocket (terminal) ────────────────────────────────────── -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-websocket</artifactId>
		</dependency>

		<!-- ── Spring Security (BCrypt + filter chain; no form login) ───── -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-crypto</artifactId>
		</dependency>

		<!-- ── JDBC + SQLite ────────────────────────────────────────────── -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-jdbc</artifactId>
		</dependency>
		<!-- sqlite-jdbc version managed by Spring Boot BOM (3.49.1.0) -->
		<dependency>
			<groupId>org.xerial</groupId>
			<artifactId>sqlite-jdbc</artifactId>
		</dependency>

		<!-- ── Database migrations ─────────────────────────────────────── -->
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
		</dependency>

		<!-- ── JSON ─────────────────────────────────────────────────────── -->
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
		</dependency>

		<!-- ── Spring AI — prompt templates + RAG (no auto-config) ──────── -->
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-client-chat</artifactId>
		</dependency>

		<!-- ── PDF text extraction (RAG document ingestion) ────────────── -->
		<dependency>
			<groupId>org.apache.pdfbox</groupId>
			<artifactId>pdfbox</artifactId>
			<version>${pdfbox.version}</version>
		</dependency>

		<!-- ── SSO: JWT / OIDC id_token validation ─────────────────────── -->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-oauth2-jose</artifactId>
		</dependency>

		<!-- ── Test ─────────────────────────────────────────────────────── -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

	</dependencies>

	<!-- ===================================================================
	     Build
	     =================================================================== -->
	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<!-- SQLite JDBC uses System.load() for its native binary.
					     Java 21+ requires explicit native-access permission for
					     unnamed modules or it prints a WARNING on every boot.
					     Java 24+ will block it entirely without this flag. -->
					<jvmArguments>--enable-native-access=ALL-UNNAMED</jvmArguments>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
