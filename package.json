{
  "name": "olla-nest",
  "version": "1.0.0",
  "description": "Company-ready local AI workspace for Ollama with admin controls and automatic model routing.",
  "main": "server.js",
  "license": "MIT",
  "author": "Ashok Ram",
  "keywords": [
    "ollama",
    "local-ai",
    "ai-workspace",
    "model-router",
    "admin-dashboard",
    "open-source-ai"
  ],
  "scripts": {
    "start": "echo \"Olla Nest is Docker-only. Use: docker compose up --build\" && exit 1",
    "container:start": "node server.js",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app",
    "docker:restart": "docker compose restart app"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1"
  }
}
