<?xml version="1.0" encoding="UTF-8"?>
<!--
  Olla Nest — Logback configuration (loki4j 1.5.2)
  ─────────────────────────────────────────────────
  Appenders:
    CONSOLE  — coloured, human-readable (always on)
    LOKI     — structured JSON pushed to Grafana Loki on port 3100

  MDC keys set by MdcLoggingFilter on every HTTP request:
    requestId, userId, userEmail, userRole, method, path, ip
-->
<configuration>

    <!-- ── Properties ──────────────────────────────────────────────── -->
    <springProperty name="APP_NAME" source="spring.application.name" defaultValue="olla-nest"/>
    <springProperty name="LOKI_URL" source="loki.url"                defaultValue="http://localhost:3100/loki/api/v1/push"/>

    <!-- ── Console appender ─────────────────────────────────────────── -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight(%-5level) [%15.15t] %-40.40logger{39} : %msg%n%ex</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ── Loki appender ────────────────────────────────────────────── -->
    <!--
      Labels must be low-cardinality (few distinct values) — Loki indexes these.
      High-cardinality values (userId, requestId, path, email) go in the message line.
      Labels must never be empty strings — keep only static + level here.
    -->
    <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
        <!-- Batch: flush every 1s or 500 events, whichever first -->
        <batchMaxItems>500</batchMaxItems>
        <batchTimeoutMs>1000</batchTimeoutMs>

        <http class="com.github.loki4j.logback.JavaHttpSender">
            <url>${LOKI_URL}</url>
            <connectTimeoutMs>5000</connectTimeoutMs>
            <requestTimeoutMs>5000</requestTimeoutMs>
        </http>

        <format>
            <label>
                <!-- Only static / low-cardinality labels — no MDC here to avoid empty-value crashes -->
                <pattern>app=${APP_NAME},level=%level,logger=%logger{20}</pattern>
            </label>
            <message>
                <!--
                  Full structured line — every field queryable with LogQL in Grafana.
                  MDC keys will be "anon" / "" if the filter hasn't run (startup logs).
                -->
                <pattern>level=%level requestId=%X{requestId:-startup} userId=%X{userId:-system} email=%X{userEmail:-system} role=%X{userRole:-system} method=%X{method:-INTERNAL} path=%X{path:-/} ip=%X{ip:-localhost} logger=%logger{30} thread=%thread msg=%msg%n%ex{5}</pattern>
            </message>
        </format>
    </appender>

    <!-- ── Async wrapper — non-blocking, drops if queue full ────────── -->
    <appender name="LOKI_ASYNC" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="LOKI"/>
        <queueSize>10000</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>true</neverBlock>
    </appender>

    <!-- ── Noise reduction ──────────────────────────────────────────── -->
    <logger name="org.flywaydb"                 level="WARN"/>
    <logger name="org.springframework.security" level="WARN"/>
    <logger name="org.springframework.web"      level="WARN"/>
    <logger name="com.zaxxer.hikari"            level="WARN"/>
    <logger name="org.apache.catalina"          level="WARN"/>
    <logger name="org.apache.tomcat"            level="WARN"/>

    <!-- ── Application code — INFO and above ────────────────────────── -->
    <logger name="com.ollanest" level="INFO"/>

    <!-- ── Root ─────────────────────────────────────────────────────── -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="LOKI_ASYNC"/>
    </root>

</configuration>
