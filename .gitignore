# Maven build output
target/
*.class
*.jar
*.war

# Runtime data (generated by the app)
data/

# Environment secrets
.env

# E2E/perf local credentials (disposable test creds — never commit literals)
e2e/.e2e-creds.js

# macOS
.DS_Store
**/.DS_Store

# Editor / OS
*.log
.vscode/
.idea/
.claude/

# Eclipse IDE
.classpath
.project
.settings/
*.launch

# Local business docs
PROJECT_BUSINESS_OVERVIEW.txt

# Monitoring binaries & runtime data (downloaded by start_monitoring.sh)
scripts/monitoring/loki-bin/
scripts/monitoring/grafana/
scripts/monitoring/loki-data/
scripts/monitoring/pids/
scripts/monitoring/loki.log
scripts/monitoring/grafana.log

# Grafana admin password (generated locally — never commit)
scripts/monitoring/.grafana-password
scripts/e2e-test.sh

# Python virtualenv created by dev scripts
scripts/venv/
venv/
.venv/

# Eclipse JDT annotation-processor config (generated by m2e when the
# spring-boot-configuration-processor is on the build path)
.factorypath
